---
// Neutral stand-in for content Ziqi still has to supply. Hidden once SHOW_PLACEHOLDERS is false.
import { SHOW_PLACEHOLDERS } from '../site';

interface Props {
  need: string;
}

const { need } = Astro.props;
---

{SHOW_PLACEHOLDERS && <p class="draft">Draft · {need}</p>}

<style>
  .draft {
    margin-top: 40px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px dashed var(--line);
    color: var(--faint);
    font-size: 13px;
  }
</style>
