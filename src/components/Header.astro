---
import { site } from '../site';
---

<header class="wrap">
  <a href="/" class="name">{site.name}</a>
  <nav aria-label="Primary">
    <a href="/#work">Work</a>
    <a href="/#experience">Experience</a>
    <a href={site.resume} target="_blank" rel="noopener">Resume</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }
  .name {
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    gap: 24px;
    font-size: 15px;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--fg);
  }
  @media (max-width: 640px) {
    nav {
      gap: 16px;
    }
  }
</style>
