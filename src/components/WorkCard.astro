---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const d = entry.data;
// Wide cards put the story beside the image so portrait screenshots do not float in empty space.
const split = d.wide && d.cover;
---

<a href={`/work/${entry.id}/`} class:list={['card', d.wide && 'wide']}>
  {
    split ? (
      <div class:list={['frame', 'split', `tint-${d.tint}`, d.coverFit === 'cover' && 'landscape']}>
        <div class="text">
          <p class="org">{d.paper ? d.paper.venue : d.org}</p>
          <h3>{d.paper ? d.paper.title : d.title}</h3>
          <p class="sub">{d.paper ? d.paper.authors : d.summary}</p>
          {d.metric && (
            <p class="stat-inline">
              <strong>{d.metric}</strong>
              <span>{d.metricLabel}</span>
            </p>
          )}
          <span class="more-link">Read the case study →</span>
        </div>
        <div class="visual">
          <Image
            src={d.cover!}
            alt={d.coverAlt ?? ''}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 767px) 100vw, 640px"
            loading={eager ? 'eager' : 'lazy'}
          />
        </div>
      </div>
    ) : (
      <>
        <div class:list={['frame', `tint-${d.tint}`, !d.cover && 'is-stat']}>
          {d.cover ? (
            <Image
              src={d.cover}
              alt={d.coverAlt ?? ''}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 767px) 100vw, 560px"
              loading={eager ? 'eager' : 'lazy'}
            />
          ) : (
            <div class="stat">
              <strong>{d.metric}</strong>
              <span>{d.metricLabel}</span>
            </div>
          )}
        </div>
        <div class="caption">
          <div>
            <h3>{d.title}</h3>
            <p class="muted">{d.summary}</p>
          </div>
          <span class="org">{d.org}</span>
        </div>
      </>
    )
  }
</a>

<style>
  .card {
    display: block;
  }
  .frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }
  .tint-gray {
    background: var(--surface);
  }
  .tint-blue {
    background: var(--tint-blue);
  }
  .tint-ink {
    background: var(--ink);
    color: #f4f5f8;
  }

  /* Wide: text left, image right */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: stretch;
    height: 440px;
  }
  .split .text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    padding: 48px;
  }
  .split h3 {
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }
  .split .sub {
    font-size: 15px;
    color: var(--muted);
    max-width: 44ch;
  }
  .tint-ink .sub,
  .tint-ink .stat-inline span,
  .tint-ink .org {
    color: rgb(244 245 248 / 0.65);
  }
  .stat-inline {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 14px;
  }
  .stat-inline strong {
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .stat-inline span {
    font-size: 14px;
    color: var(--muted);
  }
  .more-link {
    margin-top: 18px;
    font-size: 14px;
    font-weight: 500;
  }
  .card:hover .more-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .visual {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 48px 48px 0 0;
    overflow: hidden;
  }
  .visual :global(img) {
    flex: none;
    width: 100%;
    max-width: 520px;
    height: auto;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 12px 32px rgb(21 26 43 / 0.14);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .landscape .visual {
    align-items: center;
    padding: 40px 40px 40px 0;
  }
  .landscape .visual :global(img) {
    max-width: none;
    border-radius: 8px;
    background: #fff;
    padding: 12px;
  }
  .card:hover .visual :global(img) {
    transform: translateY(-3px);
  }

  /* Half-width cards */
  .frame:not(.split) {
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 40px 40px 0;
  }
  .frame:not(.split) :global(img) {
    flex: none;
    width: min(100%, 420px);
    height: auto;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 12px 32px rgb(21 26 43 / 0.12);
  }
  .is-stat {
    aspect-ratio: 16 / 9 !important;
    align-items: center !important;
    padding: 32px !important;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  .stat strong {
    font-size: clamp(56px, 7vw, 88px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat span {
    font-size: 15px;
    color: var(--muted);
    max-width: 30ch;
  }
  .caption {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 4px 0;
  }
  .caption h3 {
    font-size: 16px;
  }
  .caption p {
    margin-top: 4px;
    max-width: 60ch;
  }
  .card:hover .caption h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .org {
    font-size: 13px;
    color: var(--faint);
    white-space: nowrap;
  }
  .caption .org {
    padding-top: 2px;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      height: auto;
    }
    .split .text {
      padding: 32px 28px 8px;
    }
    .visual,
    .landscape .visual {
      padding: 24px 28px 0;
      max-height: 360px;
    }
    .landscape .visual {
      padding-bottom: 28px;
    }
  }
  @media (max-width: 767px) {
    .frame:not(.split) {
      padding: 24px 24px 0;
    }
    .caption {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
