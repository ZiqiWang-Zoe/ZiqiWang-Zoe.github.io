---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const d = entry.data;
---

<a href={`/work/${entry.id}/`} class:list={['card', d.wide && 'wide']}>
  <div class:list={['frame', `tint-${d.tint}`, !d.cover && 'is-stat', d.coverFit === 'cover' && 'landscape', d.paper && 'is-paper']}>
    {
      d.paper && d.cover ? (
        <div class="paper">
          <div class="paper-text">
            <p class="venue">{d.paper.venue}</p>
            <p class="paper-title">{d.paper.title}</p>
            <p class="authors">{d.paper.authors}</p>
            {d.metric && (
              <p class="paper-stat">
                <strong>{d.metric}</strong>
                <span>{d.metricLabel}</span>
              </p>
            )}
          </div>
          <div class="sheet">
            <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[800, 1600]} sizes="(max-width: 767px) 100vw, 620px" loading="eager" />
          </div>
        </div>
      ) : d.cover ? (
        <Image
          src={d.cover}
          alt={d.coverAlt ?? ''}
          widths={[640, 1280]}
          sizes={d.wide ? '(max-width: 640px) 100vw, 1040px' : '(max-width: 640px) 100vw, 520px'}
          loading="eager"
        />
      ) : (
        <div class="stat">
          <strong>{d.metric}</strong>
          <span>{d.metricLabel}</span>
        </div>
      )
    }
  </div>
  <div class="caption">
    <div>
      <h3>{d.title}</h3>
      <p class="muted">{d.summary}</p>
    </div>
    <span class="org">{d.org}</span>
  </div>
</a>

<style>
  .card {
    display: block;
  }
  .frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 40px 40px 0;
  }
  .wide .frame {
    aspect-ratio: 21 / 9;
    padding: 48px 48px 0;
  }
  .tint-gray {
    background: var(--surface);
  }
  .tint-blue {
    background: var(--tint-blue);
  }
  .tint-ink {
    background: var(--ink);
    color: #f4f5f8;
  }
  .frame img {
    width: min(100%, 420px);
    height: auto;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 12px 32px rgb(21 26 43 / 0.12);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .wide .frame img {
    width: min(100%, 520px);
  }
  .wide .landscape {
    align-items: center;
    padding: 48px;
  }
  .wide .landscape img {
    width: min(100%, 820px);
    border-radius: 8px;
  }
  .card:hover .frame img {
    transform: translateY(-3px);
  }
  .is-stat {
    align-items: center;
    padding: 40px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .stat strong {
    font-size: clamp(56px, 8vw, 96px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat span {
    font-size: 15px;
    color: var(--muted);
    max-width: 30ch;
  }
  .caption {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 4px 0;
  }
  .caption h3 {
    font-size: 16px;
  }
  .caption p {
    margin-top: 4px;
    max-width: 60ch;
  }
  .card:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .org {
    font-size: 13px;
    color: var(--faint);
    white-space: nowrap;
    padding-top: 2px;
  }
  .wide .is-paper {
    aspect-ratio: auto;
    padding: 48px;
    align-items: center;
  }
  .paper {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 48px;
    align-items: center;
    width: 100%;
  }
  .venue {
    font-size: 13px;
    color: var(--faint);
  }
  .paper-title {
    margin-top: 10px;
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .authors {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }
  .paper-stat {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .paper-stat strong {
    font-size: 36px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .paper-stat span {
    font-size: 14px;
    color: var(--muted);
  }
  .sheet {
    background: #fff;
    border-radius: 8px;
    padding: 16px;
    box-shadow: 0 12px 32px rgb(21 26 43 / 0.12);
  }
  .frame .sheet :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0;
    box-shadow: none;
  }
  .card:hover .frame .sheet :global(img) {
    transform: none;
  }
  @media (max-width: 767px) {
    .wide .is-paper {
      padding: 24px;
    }
    .paper {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .frame,
    .wide .frame {
      aspect-ratio: 4 / 3;
      padding: 24px 24px 0;
    }
    .caption {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
