---
import type { Entry } from '../data/timeline';

interface Props {
  title: string;
  entries: Entry[];
}

const { title, entries } = Astro.props;

const initials = (org: string) =>
  org
    .replace(/&/g, ' ')
    .split(/[\s,]+/)
    .filter((w) => /^[A-Z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join('');

// **bold** -> <strong>; the text itself is ours, so escaping first keeps it safe.
const rich = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<div class="group">
  <h3 class="group-title">{title}</h3>
  <ol class="tl">
    {
      entries.map((e) => (
        <li class:list={['item', e.current && 'current']}>
          <p class="years">{e.years}</p>
          <span class="dot" aria-hidden="true" />
          <div class="mark" aria-hidden="true">{initials(e.org)}</div>
          <div class="body">
            <p class="role">{e.role}</p>
            <p class="org">
              {e.org}
              {e.kind && <span class="kind"> · {e.kind}</span>}
            </p>
            <p class="when">
              {e.dates} · {e.place}
            </p>
            <p class="note" set:html={rich(e.note)} />
            {e.link && (
              <a class="more" href={e.link.href}>
                {e.link.text} →
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .group + .group {
    margin-top: 56px;
  }
  .group-title {
    font-size: 18px;
    font-weight: 600;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .tl {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    position: relative;
  }
  /* The vertical line runs through the dot column. */
  .tl::before {
    content: '';
    position: absolute;
    left: 127px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--line);
  }
  .item {
    display: grid;
    grid-template-columns: 112px 32px 56px minmax(0, 1fr);
    column-gap: 0;
    align-items: start;
    padding-bottom: 36px;
  }
  .item:last-child {
    padding-bottom: 0;
  }
  .years {
    text-align: right;
    font-size: 13px;
    color: var(--faint);
    padding: 2px 12px 0 0;
    font-variant-numeric: tabular-nums;
  }
  .dot {
    justify-self: center;
    margin-top: 7px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--faint);
    box-shadow: 0 0 0 4px var(--bg);
    position: relative;
  }
  .current .years {
    color: var(--accent);
    font-weight: 500;
  }
  .current .dot {
    background: var(--accent);
  }
  .mark {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--card);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .body {
    padding-left: 16px;
  }
  .role {
    font-size: 16px;
    font-weight: 600;
  }
  .org {
    margin-top: 2px;
  }
  .kind,
  .when {
    color: var(--muted);
  }
  .when {
    font-size: 13px;
    margin-top: 2px;
  }
  .note {
    margin-top: 10px;
    max-width: 72ch;
    color: var(--muted);
  }
  .note :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }
  .more {
    display: inline-block;
    margin-top: 8px;
    font-size: 14px;
    color: var(--accent);
  }
  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 767px) {
    .tl::before {
      left: 4px;
    }
    .item {
      grid-template-columns: 9px minmax(0, 1fr);
      column-gap: 16px;
    }
    .years {
      grid-column: 2;
      grid-row: 1;
      text-align: left;
      padding: 0;
    }
    .dot {
      grid-column: 1;
      grid-row: 1;
      margin-top: 5px;
    }
    .mark {
      display: none;
    }
    .body {
      grid-column: 2;
      padding-left: 0;
      margin-top: 4px;
    }
  }
</style>
