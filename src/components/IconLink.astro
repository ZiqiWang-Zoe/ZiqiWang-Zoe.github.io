---
// Pill link with a leading icon. All icons are Phosphor "regular" so stroke weight matches.
import envelope from '@phosphor-icons/core/assets/regular/envelope-simple.svg?raw';
import resume from '@phosphor-icons/core/assets/regular/file-text.svg?raw';
import linkedin from '@phosphor-icons/core/assets/regular/linkedin-logo.svg?raw';
import scholar from '@phosphor-icons/core/assets/regular/graduation-cap.svg?raw';

const icons = { envelope, resume, linkedin, scholar };

interface Props {
  icon: keyof typeof icons;
  href: string;
  text: string;
  label?: string;
  primary?: boolean;
  external?: boolean;
}

const { icon, href, text, label, primary = false, external = false } = Astro.props;
---

<a
  class:list={['btn', primary && 'primary']}
  href={href}
  aria-label={label}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <span class="ico" set:html={icons[icon]} />
  <span>{text}</span>
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px 0 14px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--fg);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgb(21 26 43 / 0.04);
    transition: background 0.2s, border-color 0.2s, transform 0.15s;
  }
  .btn:hover {
    background: var(--surface);
  }
  .btn:active {
    transform: translateY(1px);
  }
  .primary {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .primary:hover {
    background: #2a2c31;
  }
  .ico {
    display: grid;
  }
  .ico :global(svg) {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
</style>
