---
import { site } from '../site';
---

<footer class="wrap" id="contact">
  <div class="cta">
    <h2>Hiring for technical, product or growth marketing?</h2>
    <p class="muted">I am based in San Jose and looking for full-time roles in the Bay Area.</p>
    <div class="links">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>
      <a class="btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn" href={site.resume} target="_blank" rel="noopener">Resume</a>
    </div>
  </div>
  <p class="fine muted">{site.email}</p>
</footer>

<style>
  footer {
    margin-top: 120px;
    padding-top: 56px;
    padding-bottom: 48px;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: clamp(24px, 3.4vw, 32px);
    max-width: 22ch;
  }
  .cta p {
    margin-top: 12px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .fine {
    margin-top: 56px;
    font-size: 14px;
  }
</style>
