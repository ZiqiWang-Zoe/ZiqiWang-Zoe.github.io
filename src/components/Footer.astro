---
import { site } from '../site';
---

<footer class="wrap">
  <div class="inner">
  <p>Looking for full-time technical, product or growth marketing roles in the Bay Area.</p>
  <p class="links muted">
    <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
    <a class="link" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a class="link" href={site.resume} target="_blank" rel="noopener">Resume</a>
  </p>
  </div>
</footer>

<style>
  footer {
    margin-top: 96px;
    padding-bottom: 64px;
  }
  .inner {
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 8px;
  }
</style>
