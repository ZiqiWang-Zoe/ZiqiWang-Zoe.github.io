---
// Email shown as selectable text, with a copy button. Icons are Phosphor "regular" to match IconLink.
import envelope from '@phosphor-icons/core/assets/regular/envelope-simple.svg?raw';
import copy from '@phosphor-icons/core/assets/regular/copy.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check.svg?raw';

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<div class="email">
  <a class="addr" href={`mailto:${email}`}>
    <span class="ico" aria-hidden="true" set:html={envelope} />
    <span class="text">{email}</span>
  </a>
  <button class="copy" type="button" data-email={email} aria-label="Copy email address" title="Copy">
    <span class="ico when-idle" aria-hidden="true" set:html={copy} />
    <span class="ico when-done" aria-hidden="true" set:html={check} />
  </button>
  <span class="sr-status" role="status" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.email .copy').forEach((btn) => {
    const status = btn.parentElement?.querySelector('.sr-status');
    const text = btn.parentElement?.querySelector('.text');
    let timer: number | undefined;
    const show = (copied: boolean) => {
      btn.classList.toggle('done', copied);
      btn.title = copied ? 'Copied' : 'Copy';
      btn.setAttribute('aria-label', copied ? 'Email address copied' : 'Copy email address');
      if (status) status.textContent = copied ? 'Email address copied' : '';
    };
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email ?? '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(email);
        copied = true;
      } catch {
        // Older browsers: select the address and use the legacy copy command.
        if (text) window.getSelection()?.selectAllChildren(text);
        copied = document.execCommand('copy');
      }
      if (!copied) {
        if (status) status.textContent = 'Address selected. Press Command or Control C to copy.';
        return;
      }
      clearTimeout(timer);
      show(true);
      timer = window.setTimeout(() => show(false), 1600);
    });
  });
</script>

<style>
  .email {
    display: inline-flex;
    align-items: stretch;
    height: 40px;
    max-width: 100%;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--fg);
    box-shadow: 0 1px 2px rgb(21 26 43 / 0.04);
    overflow: hidden;
  }
  .addr {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding: 0 14px;
    color: inherit;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.2s;
  }
  .text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .copy {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    border: 0;
    border-left: 1px solid var(--line);
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .addr:hover,
  .copy:hover {
    background: var(--surface);
  }
  .copy:hover {
    color: var(--fg);
  }
  .copy.done {
    color: var(--accent);
  }
  .addr:focus-visible,
  .copy:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .ico {
    display: grid;
  }
  .ico :global(svg) {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .copy .ico :global(svg) {
    width: 16px;
    height: 16px;
  }
  .when-done,
  .copy.done .when-idle {
    display: none;
  }
  .copy.done .when-done {
    display: grid;
  }
  .sr-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .addr,
    .copy {
      transition: none;
    }
  }
</style>
