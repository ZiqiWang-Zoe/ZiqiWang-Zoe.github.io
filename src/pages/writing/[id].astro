---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, showDraft } from '../../site';

export async function getStaticPaths() {
  const all = await getCollection('writing');
  return all
    .filter((entry) => showDraft(entry.data.status))
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const date = d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const subscribe = site.newsletter.url;
---

<Base title={d.title} description={d.summary} narrow noindex={d.status !== 'published'}>
  <article class="col">
    <a href="/#writing" class="back muted">Ziqi Wang</a>

    <header>
      {d.status === 'draft' && <p class="draft">Draft, visible only in local preview</p>}
      <h1>{d.title}</h1>
      <p class="lede muted">{d.summary}</p>
      <p class="meta">
        {site.name}, {date}
        {d.beehiiv && <> | <a href={d.beehiiv}>Also on {site.newsletter.name}</a></>}
      </p>
    </header>

    <div class="body">
      <Content />
    </div>

    {
      subscribe && (
        <aside class="subscribe">
          <p>
            This post is part of <strong>{site.newsletter.name}</strong>, a free weekly newsletter on AI infrastructure,
            from chips to model serving.
          </p>
          <a href={subscribe} class="button">Subscribe</a>
        </aside>
      )
    }
  </article>
</Base>

<style>
  article {
    max-width: 800px;
    padding-top: 80px;
    padding-bottom: 32px;
  }
  .back::before {
    content: '← ';
  }
  .back:hover {
    color: var(--fg);
  }
  header {
    margin-top: 48px;
  }
  .draft {
    display: inline-block;
    font-size: 13px;
    color: var(--muted);
    background: var(--surface);
    border-radius: 999px;
    padding: 4px 12px;
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(24px, 4.4vw, 30px);
    letter-spacing: -0.025em;
    line-height: 1.25;
  }
  .lede {
    margin-top: 12px;
    max-width: 680px;
  }
  .meta {
    margin-top: 16px;
    font-size: 14px;
    color: var(--faint);
  }
  .meta a {
    color: var(--accent);
  }
  .body {
    margin-top: 40px;
    max-width: 680px;
    font-size: 16px;
  }
  .body :global(h2) {
    font-size: 18px;
    margin: 40px 0 10px;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 14px;
  }
  .body :global(ul),
  .body :global(ol) {
    padding-left: 18px;
  }
  .body :global(li) {
    margin-bottom: 6px;
  }
  .body :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 3px;
  }
  .body :global(strong) {
    font-weight: 500;
  }
  .body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .body :global(p:has(> img)) {
    margin-bottom: 8px;
  }
  .body :global(p:has(> img) + p em) {
    font-size: 14px;
    color: var(--faint);
    font-style: normal;
  }
  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin: 4px 0 20px;
    display: block;
    overflow-x: auto;
  }
  .body :global(th),
  .body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 8px 14px 8px 0;
    border-bottom: 1px solid var(--line, #e6e8eb);
  }
  .body :global(th) {
    color: var(--faint);
    font-weight: 400;
  }
  .body :global(td:first-child) {
    color: var(--muted);
  }
  .subscribe {
    margin-top: 48px;
    max-width: 680px;
    padding: 24px;
    border-radius: 16px;
    background: var(--surface);
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }
  .subscribe p {
    margin: 0;
  }
  .subscribe strong {
    font-weight: 500;
  }
  .button {
    flex: none;
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    padding: 10px 20px;
    font-size: 15px;
  }
  @media (max-width: 640px) {
    article {
      padding-top: 48px;
    }
    .subscribe {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
