---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { SHOW_PLACEHOLDERS } from '../../site';

export async function getStaticPaths() {
  const all = await getCollection('work');
  // Planned work has nothing to show yet, so it only gets a page while placeholders are on.
  return all
    .filter((entry) => SHOW_PLACEHOLDERS || entry.data.status !== 'planned')
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.summary} narrow article>
  <article class="col">
    <a href="/#work" class="back muted">Ziqi Wang</a>

    <header>
      <h1>{d.title}</h1>
      <p class="lede muted">{d.summary}</p>
      <dl>
        <div><dt>Where</dt><dd>{d.org}</dd></div>
        <div><dt>When</dt><dd>{d.period}</dd></div>
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        {d.metric && <div><dt>Result</dt><dd>{d.metric} {d.metricLabel}</dd></div>}
      </dl>
    </header>

    {
      d.cover && (
        <figure class:list={['frame', d.coverFit === 'cover' && 'landscape']}>
          <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 960, 1280, 1600, 1920]} sizes={d.coverFit === 'cover' ? '(max-width: 640px) 100vw, 912px' : '(max-width: 640px) 100vw, 592px'} loading="eager" />
        </figure>
      )
    }

    <div class="body">
      <Content />
    </div>

    {SHOW_PLACEHOLDERS && d.todo.length > 0 && <Placeholder need={`Still needed: ${d.todo.join('; ')}`} />}
  </article>
</Base>

<style>
  article {
    max-width: 800px;
    padding-top: 80px;
  }
  .back::before {
    content: '← ';
  }
  .back:hover {
    color: var(--fg);
  }
  header {
    margin-top: 48px;
  }
  h1 {
    font-size: clamp(24px, 4.4vw, 30px);
    letter-spacing: -0.025em;
    line-height: 1.25;
  }
  .lede {
    margin-top: 12px;
    max-width: 680px;
  }
  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
    margin: 28px 0 0;
  }
  dt {
    font-size: 13px;
    color: var(--faint);
  }
  dd {
    margin: 2px 0 0;
  }
  .frame {
    width: min(960px, calc(100vw - 48px));
    margin: 48px 0 0 50%;
    transform: translateX(-50%);
    border-radius: 16px;
    background: var(--surface);
    padding: 48px 48px 0;
    max-height: 620px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  /* Never let flex stretch an image: width drives size, height follows the real ratio. */
  .frame img {
    flex: none;
    width: min(100%, 560px);
    height: auto;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 12px 32px rgb(21 26 43 / 0.12);
  }
  .landscape {
    max-height: none;
    padding: 48px;
    align-items: center;
  }
  .landscape img {
    width: 100%;
    border-radius: 8px;
    background: #fff;
    padding: 16px;
  }
  .body {
    margin-top: 48px;
    max-width: 680px;
    font-size: 16px;
  }
  .body :global(h2) {
    font-size: 15px;
    margin: 40px 0 10px;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 14px;
  }
  .body :global(ul),
  .body :global(ol) {
    padding-left: 18px;
  }
  .body :global(li) {
    margin-bottom: 6px;
  }
  .body :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 3px;
  }
  .body :global(strong) {
    font-weight: 500;
  }
  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin: 4px 0 20px;
    display: block;
    overflow-x: auto;
  }
  .body :global(th),
  .body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 8px 14px 8px 0;
  }
  .body :global(th) {
    color: var(--faint);
    font-weight: 400;
  }
  .body :global(td:first-child) {
    white-space: nowrap;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    article {
      padding-top: 48px;
    }
    .frame {
      width: calc(100vw - 40px);
      padding: 20px 20px 0;
    }
    .frame img {
      width: 92%;
    }
    .landscape {
      padding: 20px;
    }
    .landscape img {
      width: 100%;
      padding: 8px;
    }
  }
</style>
