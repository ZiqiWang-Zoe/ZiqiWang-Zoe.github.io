---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { SHOW_PLACEHOLDERS } from '../../site';

export async function getStaticPaths() {
  const all = await getCollection('work');
  // Planned work has nothing to show yet, so it only gets a page while placeholders are on.
  return all
    .filter((entry) => SHOW_PLACEHOLDERS || entry.data.status !== 'planned')
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// Group the gallery into runs, in order: consecutive regular photos share a two-column block, wide photos stand alone.
const runs: { wide: boolean; items: typeof d.gallery }[] = [];
for (const g of d.gallery) {
  const last = runs[runs.length - 1];
  if (!g.wide && last && !last.wide) last.items.push(g);
  else runs.push({ wide: g.wide, items: [g] });
}
---

<Base title={d.title} description={d.summary} narrow article>
  <article class="col">
    <a href="/#work" class="back muted">Ziqi Wang</a>

    <header>
      <h1>{d.title}</h1>
      <p class="lede muted">{d.summary}</p>
      <dl>
        <div><dt>Where</dt><dd>{d.org}</dd></div>
        <div><dt>When</dt><dd>{d.period}</dd></div>
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        {d.metric && <div><dt>Result</dt><dd>{d.metric} {d.metricLabel}</dd></div>}
      </dl>
    </header>

    {
      d.cover && (
        <figure class:list={['frame', d.coverFit === 'cover' && 'landscape', d.coverFit === 'photo' && 'photo']}>
          <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 960, 1280, 1600, 1920]} sizes={d.coverFit === 'contain' ? '(max-width: 640px) 100vw, 592px' : '(max-width: 640px) 100vw, 960px'} loading="eager" />
        </figure>
      )
    }

    <div class="body">
      <Content />
    </div>

    {
      d.gallery.length > 0 && (
        <section class="gallery" aria-label="Photos">
          {runs.map((run) =>
            run.wide ? (
              <figure class="wide">
                <Image src={run.items[0].src} alt={run.items[0].alt} widths={[640, 960, 1280, 1920]} sizes="(max-width: 700px) 100vw, 960px" />
                <figcaption>{run.items[0].caption}</figcaption>
              </figure>
            ) : (
              <div class="cols">
                {run.items.map((g) => (
                  <figure>
                    <Image src={g.src} alt={g.alt} widths={[480, 720, 960]} sizes="(max-width: 700px) 100vw, 472px" />
                    <figcaption>{g.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )
          )}
        </section>
      )
    }

    {SHOW_PLACEHOLDERS && d.todo.length > 0 && <Placeholder need={`Still needed: ${d.todo.join('; ')}`} />}
  </article>
</Base>

<style>
  article {
    max-width: 800px;
    padding-top: 80px;
  }
  .back::before {
    content: '← ';
  }
  .back:hover {
    color: var(--fg);
  }
  header {
    margin-top: 48px;
  }
  h1 {
    font-size: clamp(24px, 4.4vw, 30px);
    letter-spacing: -0.025em;
    line-height: 1.25;
  }
  .lede {
    margin-top: 12px;
    max-width: 680px;
  }
  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
    margin: 28px 0 0;
  }
  dt {
    font-size: 13px;
    color: var(--faint);
  }
  dd {
    margin: 2px 0 0;
  }
  .frame {
    width: min(960px, calc(100vw - 48px));
    margin: 48px 0 0 50%;
    transform: translateX(-50%);
    border-radius: 16px;
    background: var(--surface);
    padding: 48px 48px 0;
    max-height: 620px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  /* Never let flex stretch an image: width drives size, height follows the real ratio. */
  .frame img {
    flex: none;
    width: min(100%, 560px);
    height: auto;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 12px 32px rgb(21 26 43 / 0.12);
  }
  .landscape {
    max-height: none;
    padding: 48px;
    align-items: center;
  }
  .landscape img {
    width: 100%;
    border-radius: 8px;
    background: #fff;
    padding: 16px;
  }
  /* Event photo: edge to edge, no padding or shadow. */
  .photo {
    max-height: none;
    padding: 0;
    background: none;
  }
  .photo img {
    width: 100%;
    border-radius: 16px;
    box-shadow: none;
  }
  .gallery {
    width: min(960px, calc(100vw - 48px));
    margin: 56px 0 0 50%;
    transform: translateX(-50%);
  }
  .cols {
    columns: 2;
    column-gap: 16px;
  }
  .gallery figure {
    margin: 0 0 28px;
    break-inside: avoid;
  }
  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    background: var(--surface);
  }
  .gallery .wide + .cols,
  .gallery .cols + .wide {
    margin-top: 20px;
  }
  .gallery figcaption {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
    max-width: 60ch;
  }
  .body {
    margin-top: 48px;
    max-width: 680px;
    font-size: 16px;
  }
  .body :global(h2) {
    font-size: 15px;
    margin: 40px 0 10px;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 14px;
  }
  .body :global(ul),
  .body :global(ol) {
    padding-left: 18px;
  }
  .body :global(li) {
    margin-bottom: 6px;
  }
  .body :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 3px;
  }
  .body :global(strong) {
    font-weight: 500;
  }
  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin: 4px 0 20px;
    display: block;
    overflow-x: auto;
  }
  .body :global(th),
  .body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 8px 14px 8px 0;
  }
  .body :global(th) {
    color: var(--faint);
    font-weight: 400;
  }
  .body :global(td:first-child) {
    white-space: nowrap;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    article {
      padding-top: 48px;
    }
    .frame {
      width: calc(100vw - 40px);
      padding: 20px 20px 0;
    }
    .frame img {
      width: 92%;
    }
    .landscape {
      padding: 20px;
    }
    .landscape img {
      width: 100%;
      padding: 8px;
    }
    .photo {
      padding: 0;
    }
    .photo img {
      width: 100%;
      border-radius: 12px;
    }
    .gallery {
      width: calc(100vw - 40px);
    }
  }
  @media (max-width: 700px) {
    .cols {
      columns: 1;
    }
  }
</style>
