---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import headshot from '../assets/ziqi.jpg';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site, SHOW_PLACEHOLDERS } from '../site';

const work = (await getCollection('work'))
  .filter((w) => SHOW_PLACEHOLDERS || w.data.status !== 'planned')
  .sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((w) => w.data.featured);
const more = work.filter((w) => !w.data.featured);

// Every number here is on her resume; see profiles/ziqi/corpus/experience.md.
const stats = [
  { value: '1K → 7K', label: 'average short-form views per post', org: 'Echobend' },
  { value: '+11.7%', label: 'engagement from Meta Ads campaigns', org: 'Echobend' },
  { value: '+12%', label: 'backlinks from SEO and content work', org: 'CambioML' },
];

const certs = [
  { name: 'Google Ads Search', issuer: 'Google', when: '2023' },
  { name: 'Google Ads Display', issuer: 'Google', when: '2023' },
  { name: 'Google Analytics', issuer: 'Google', when: '2025', url: 'https://skillshop.credential.net/999b3c90-1d12-484b-8c0b-2e656d71c151#acc.NxMrTO6C' },
  { name: 'Amazon Sponsored Ads', issuer: 'Amazon', when: '2022' },
  { name: 'Social Media Monitoring', issuer: 'LinkedIn Learning', when: '2023', url: 'https://www.linkedin.com/learning/certificates/41c38e4a1d0e02eaa22ba31bf0d521481b02b3c78d5f7c2ce2cbaeafa962c09e' },
];

const experience = [
  { when: '2026', role: 'Technical Marketing Intern', org: 'Futurewei' },
  { when: '2026', role: 'Marketing Volunteer', org: 'CASPA' },
  { when: '2024', role: 'Social Media Intern', org: 'Echobend' },
  { when: '2024', role: 'Marketing Intern, B2B and Growth', org: 'CambioML' },
  { when: '2023', role: 'Digital Media Assistant', org: 'University of Illinois' },
  { when: '2022', role: 'UX Researcher', org: 'University of Illinois' },
  { when: '2022', role: 'Advertising Campaigner', org: 'Amazon & GO' },
  { when: '2022', role: 'Co-founder and President', org: 'Choom dance crew' },
  { when: '2021', role: 'Brand Representative', org: 'Abercrombie & Fitch' },
];

const education = [
  { when: '2026', role: 'M.S. Digital Social Media', org: 'USC' },
  { when: '2024', role: 'B.S. Advertising', org: 'University of Illinois' },
];
---

<Base>
  <section class="wrap hero">
    <div class="intro">
      <div class="me">
        <Image class="avatar" src={headshot} alt="Ziqi Wang" width={144} height={144} loading="eager" />
        <div>
          <h1>{site.name}</h1>
          <p class="muted">Technical Marketing @ Futurewei</p>
        </div>
      </div>
      <p class="statement">I turn complex AI and semiconductor products into stories, campaigns and tools people use.</p>
      <p class="muted about">
        Technical marketer in San Jose. Semiconductor market research at Futurewei, B2B growth at an AI
        startup, paid and short-form social, and co-first author of <a class="link" href="/work/l-mars/">L-MARS</a>,
        a paper on how AI systems choose which sources to cite.
      </p>
      <div class="actions">
        <a class="pill pill-dark" href={`mailto:${site.email}`}>Email</a>
        <a class="pill" href={site.resume} target="_blank" rel="noopener">Resume</a>
        <a class="pill" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>

    <ul class="stats">
      {
        stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span class="muted">{s.label}</span>
            <span class="where">{s.org}</span>
          </li>
        ))
      }
    </ul>
  </section>


  <section class="wrap certs-strip" aria-label="Certifications">
    <h2 class="label">Certified</h2>
    <ul class="certs">
      {
        certs.map((c) => {
          const inner = (
            <>
              <span class="cert-name">{c.name}</span>
              <span class="cert-meta">{c.issuer}, {c.when}{c.url ? ' · Verify ↗' : ''}</span>
            </>
          );
          return <li>{c.url ? <a class="cert" href={c.url} target="_blank" rel="noopener">{inner}</a> : <div class="cert">{inner}</div>}</li>;
        })
      }
    </ul>
  </section>

  <section class="wrap" id="work">
    <h2 class="label">Selected work</h2>
    <div class="grid">
      {featured.map((w, i) => <WorkCard entry={w} eager={i === 0} />)}
    </div>

    {
      more.length > 0 && (
        <div class="more">
          <h2 class="label">More work</h2>
          <ul class="rows">
            {more.map((w) => (
              <li>
                <a href={`/work/${w.id}/`} class="row">
                  <span>{w.data.title}</span>
                  <span class="muted">{w.data.org}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="wrap cv" id="experience">
    <div>
      <h2 class="label">Experience</h2>
      <ul class="rows">
        {
          experience.map((e) => (
            <li class="row">
              <span class="when">{e.when}</span>
              <span>
                {e.role} <span class="muted">at {e.org}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="label">Education</h2>
      <ul class="rows">
        {
          education.map((e) => (
            <li class="row">
              <span class="when">{e.when}</span>
              <span>
                {e.role} <span class="muted">at {e.org}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  section + section {
    margin-top: 96px;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
    gap: 80px;
    align-items: center;
    padding-top: 72px;
  }
  .me {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .me :global(.avatar) {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .me h1 {
    font-size: 22px;
    letter-spacing: -0.015em;
  }
  .me p {
    font-size: 17px;
    margin-top: 2px;
  }
  .statement {
    margin-top: 36px;
    font-size: clamp(34px, 3.6vw, 50px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 20ch;
  }
  .about {
    margin-top: 20px;
    font-size: 16px;
    max-width: 50ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }


  .stats {
    list-style: none;
    padding: 0 0 0 48px;
    margin: 0;
    border-left: 1px solid var(--line);
    display: grid;
    gap: 36px;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stats strong {
    font-size: 44px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stats span {
    font-size: 14px;
    line-height: 1.45;
    max-width: 24ch;
  }
  .where {
    color: var(--faint);
    font-size: 13px !important;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px 32px;
  }
  .grid :global(.wide) {
    grid-column: 1 / -1;
  }
  .more {
    margin-top: 72px;
    max-width: 640px;
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .row {
    display: flex;
    gap: 16px;
    padding: 7px 0;
  }
  .more .row {
    justify-content: space-between;
  }
  .more .row:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .when {
    width: 48px;
    flex-shrink: 0;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .cv {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  .certs-strip {
    margin-top: 72px;
  }
  .certs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  .cert {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--card);
    border: 1px solid var(--line);
    transition: border-color 0.2s;
  }
  a.cert:hover {
    border-color: var(--faint);
  }
  .cert-name {
    font-weight: 500;
  }
  .cert-meta {
    font-size: 13px;
    color: var(--faint);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .certs {
      grid-template-columns: 1fr 1fr;
    }
    .stats {
      padding: 32px 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
      gap: 24px;
    }
  }
  @media (max-width: 767px) {
    section + section {
      margin-top: 56px;
    }
    .hero {
      padding-top: 40px;
    }
    .grid,
    .cv {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .more .row {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
