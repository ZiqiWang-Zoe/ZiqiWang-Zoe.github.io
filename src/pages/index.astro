---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import headshot from '../assets/ziqi.jpg';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import IconLink from '../components/IconLink.astro';
import seal from '@phosphor-icons/core/assets/regular/seal-check.svg?raw';
import { site, SHOW_PLACEHOLDERS } from '../site';

const work = (await getCollection('work'))
  .filter((w) => SHOW_PLACEHOLDERS || w.data.status !== 'planned')
  .sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((w) => w.data.featured);
const more = work.filter((w) => !w.data.featured);

// Every number here is on her resume; see profiles/ziqi/corpus/experience.md.
const stats = [
  { value: '~8', label: 'stories every morning in the briefing tool she built with Claude Code', org: 'Futurewei' },
  { value: '1K → 7K', label: 'average short-form views per post', org: 'Echobend' },
  { value: '+12%', label: 'backlinks from SEO and content work', org: 'CambioML' },
];

// AI workflow. Every tool and example below is on her resume or in the case studies.
const aiWork = [
  {
    title: 'AI-assisted coding',
    body: 'Built and run IC News Daily, the Python briefing Futurewei\'s IC lab reads every morning, with Claude Code.',
    tools: 'Claude Code, Cursor, Python, VS Code',
    href: '/work/daily-news-push/',
  },
  {
    title: 'LLM agents and evaluation',
    body: 'Designed the agent harness and collected the data for L-MARS, a multi-agent system audited claim by claim.',
    tools: 'Claude, ChatGPT, Gemini, prompt design, RAG',
    href: '/work/l-mars/',
  },
  {
    title: 'Content and video production',
    body: 'Short-form video that grew from about 1K to 7K views per post, plus event video for CASPA.',
    tools: 'Premiere Pro, Final Cut Pro, CapCut, Photoshop, Canva',
    href: '/work/echobend-social/',
  },
  {
    title: 'Analytics and reporting',
    body: 'Turns 30+ industry items a week into market insight reports, and measures campaigns end to end.',
    tools: 'GA4, Meta Ads Manager, SQL, Python (pandas), Excel, PowerPoint',
    href: '/work/cambioml-seo/',
  },
];

const experience = [
  { when: '2026', role: 'Technical Marketing Intern', org: 'Futurewei' },
  { when: '2026', role: 'Marketing Volunteer', org: 'CASPA' },
  { when: '2024', role: 'Social Media Intern', org: 'Echobend' },
  { when: '2024', role: 'Marketing Intern, B2B and Growth', org: 'CambioML' },
  { when: '2023', role: 'Digital Media Assistant', org: 'University of Illinois' },
  { when: '2022', role: 'UX Researcher', org: 'University of Illinois' },
  { when: '2022', role: 'Advertising Campaigner', org: 'Amazon & GO' },
  { when: '2022', role: 'Co-founder and President', org: 'Choom dance crew' },
  { when: '2021', role: 'Brand Representative', org: 'Abercrombie & Fitch' },
];

const education = [
  { when: '2026', role: 'M.S. Digital Social Media', org: 'USC' },
  { when: '2024', role: 'B.S. Advertising', org: 'University of Illinois' },
];

const certs = [
  { name: 'Google Data Analytics', issuer: 'Google, Coursera', when: '2026', url: 'https://www.coursera.org/account/accomplishments/specialization/3BPH4R94PCVL' },
  { name: 'Google AI Essentials', issuer: 'Google, Coursera', when: '2026', url: 'https://www.coursera.org/account/accomplishments/specialization/51J86WZ63O1G' },
  { name: 'Google Analytics', issuer: 'Google', when: '2025', url: 'https://skillshop.credential.net/999b3c90-1d12-484b-8c0b-2e656d71c151#acc.NxMrTO6C' },
  { name: 'Google Ads Search', issuer: 'Google', when: '2023', id: '195888093' },
  { name: 'Google Ads Display', issuer: 'Google', when: '2023', id: '196427467' },
  { name: 'Amazon Sponsored Ads', issuer: 'Amazon Ads', when: '2022', url: 'https://learningconsole.amazonadvertising.com/student/award/LeyCPjyFyDqyJmVoWernTgxY' },
  { name: 'Social Media Monitoring', issuer: 'LinkedIn Learning', when: '2023', url: 'https://www.linkedin.com/learning/certificates/41c38e4a1d0e02eaa22ba31bf0d521481b02b3c78d5f7c2ce2cbaeafa962c09e' },
];


---

<Base>
  <section class="wrap hero">
    <div class="intro">
      <div class="me">
        <Image class="avatar" src={headshot} alt="Ziqi Wang" width={144} height={144} loading="eager" />
        <div>
          <h1>{site.name}</h1>
          <p class="muted">AI-native marketer, Technical Marketing @ Futurewei</p>
        </div>
      </div>
      <p class="statement">I turn complex AI and semiconductor products into stories, campaigns and tools people use.</p>
      <p class="muted about">
        Technical marketer in San Jose who works hands-on with current AI tools: I code with Claude Code and
        Cursor, produce and edit short-form video, and co-first authored <a class="link" href="/work/l-mars/">L-MARS</a>,
        a paper on how AI systems choose which sources to cite.
      </p>
      <div class="actions">
        <IconLink icon="envelope" href={`mailto:${site.email}`} text="Email" label={`Email ${site.email}`} primary />
        <IconLink icon="resume" href={site.resume} text="Resume" label="Resume (PDF)" external />
        <IconLink icon="linkedin" href={site.linkedin} text="LinkedIn" external />
        <IconLink icon="scholar" href={site.scholar} text="Scholar" label="Google Scholar" external />
      </div>
    </div>

    <ul class="stats">
      {
        stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span class="muted">{s.label}</span>
            <span class="where">{s.org}</span>
          </li>
        ))
      }
    </ul>
  </section>


  <section class="wrap ai" aria-labelledby="ai-title">
    <h2 id="ai-title" class="ai-title">Fluent in current AI tools, and I ship real work with them.</h2>
    <ul class="ai-grid">
      {
        aiWork.map((a) => (
          <li>
            <a href={a.href} class="ai-item">
              <h3>{a.title}</h3>
              <p class="muted">{a.body}</p>
              <p class="tools">{a.tools}</p>
              <span class="ai-link">View evidence →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap certs-strip" aria-labelledby="certs-title">
    <h2 id="certs-title" class="label">Certified</h2>
    <div class="marquee">
      {
        [false, true].map((clone) => (
          <ul class="certs" aria-hidden={clone ? 'true' : undefined}>
            {certs.map((c) => (
              <li>
                {c.url ? (
                  <a class="badge" href={c.url} target="_blank" rel="noopener" tabindex={clone ? -1 : undefined} aria-label={`${c.name}, ${c.issuer} ${c.when}. Verify credential`}>
                    <span class="seal" set:html={seal} />
                    <span class="badge-name">{c.name}</span>
                    <span class="badge-meta">{c.issuer} · {c.when}</span>
                  </a>
                ) : (
                  <span class="badge">
                    <span class="seal" set:html={seal} />
                    <span class="badge-name">{c.name}</span>
                    <span class="badge-meta">{c.issuer} · {c.when} · ID {c.id}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  <section class="wrap" id="work">
    <h2 class="label">Selected work</h2>
    <div class="grid">
      {featured.map((w, i) => <WorkCard entry={w} eager={i === 0} />)}
    </div>

    {
      more.length > 0 && (
        <div class="more">
          <h2 class="label">More work</h2>
          <ul class="rows">
            {more.map((w) => (
              <li>
                <a href={`/work/${w.id}/`} class="row">
                  <span>{w.data.title}</span>
                  <span class="muted">{w.data.org}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="wrap cv" id="experience">
    <div>
      <h2 class="label">Experience</h2>
      <ul class="rows">
        {
          experience.map((e) => (
            <li class="row">
              <span class="when">{e.when}</span>
              <span>
                {e.role} <span class="muted">at {e.org}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="label">Education</h2>
      <ul class="rows">
        {
          education.map((e) => (
            <li class="row">
              <span class="when">{e.when}</span>
              <span>
                {e.role} <span class="muted">at {e.org}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  section + section {
    margin-top: 96px;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
    gap: 80px;
    align-items: center;
    padding-top: 72px;
  }
  .me {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .me :global(.avatar) {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .me h1 {
    font-size: 22px;
    letter-spacing: -0.015em;
  }
  .me p {
    font-size: 17px;
    margin-top: 2px;
  }
  .statement {
    margin-top: 36px;
    font-size: clamp(34px, 3.6vw, 50px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 20ch;
  }
  .about {
    margin-top: 20px;
    font-size: 16px;
    max-width: 50ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }


  .stats {
    list-style: none;
    padding: 0 0 0 48px;
    margin: 0;
    border-left: 1px solid var(--line);
    display: grid;
    gap: 36px;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stats strong {
    font-size: 44px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stats span {
    font-size: 14px;
    line-height: 1.45;
    max-width: 24ch;
  }
  .where {
    color: var(--faint);
    font-size: 13px !important;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px 32px;
  }
  .grid :global(.wide) {
    grid-column: 1 / -1;
  }
  .more {
    margin-top: 72px;
    max-width: 640px;
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .row {
    display: flex;
    gap: 16px;
    padding: 7px 0;
  }
  .more .row {
    justify-content: space-between;
  }
  .more .row:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .when {
    width: 48px;
    flex-shrink: 0;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .cv {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  .ai {
    margin-top: 96px;
  }
  .ai-title {
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 500;
    letter-spacing: -0.025em;
    max-width: 26ch;
  }
  .ai-grid {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  .ai-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding-top: 18px;
    border-top: 2px solid var(--fg);
  }
  .ai-item h3 {
    font-size: 16px;
  }
  .ai-item:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ai-item p {
    font-size: 14px;
    line-height: 1.55;
  }
  .tools {
    margin-top: auto;
    padding-top: 8px;
    font-size: 13px !important;
    color: var(--faint);
  }
  .ai-link {
    font-size: 13px;
    color: var(--accent);
    margin-top: 4px;
  }
  .certs-strip {
    margin-top: 72px;
  }
  /* One slow marquee: the list scrolls sideways and pauses on hover. */
  .marquee {
    display: flex;
    overflow: hidden;
    gap: 12px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .certs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 12px;
    flex-shrink: 0;
    animation: slide 45s linear infinite;
  }
  .marquee:hover .certs,
  .marquee:focus-within .certs {
    animation-play-state: paused;
  }
  @keyframes slide {
    to {
      transform: translateX(calc(-100% - 12px));
    }
  }
  .badge {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 20px 0 14px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--line);
    white-space: nowrap;
    transition: border-color 0.2s;
  }
  a.badge[href]:hover {
    border-color: var(--faint);
  }
  .seal {
    display: grid;
    color: var(--accent);
  }
  .seal :global(svg) {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }
  .badge-name {
    font-weight: 500;
  }
  .badge-meta {
    font-size: 13px;
    color: var(--faint);
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .certs {
      animation: none;
      flex-wrap: wrap;
      flex-shrink: 1;
    }
    .certs[aria-hidden] {
      display: none;
    }
  }

  @media (max-width: 1100px) {
    .ai-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .stats {
      padding: 32px 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
      gap: 24px;
    }
  }
  @media (max-width: 767px) {
    section + section {
      margin-top: 56px;
    }
    .hero {
      padding-top: 40px;
    }
    .ai-grid,
    .grid,
    .cv {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .more .row {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
