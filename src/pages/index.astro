---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import headshot from '../assets/ziqi.jpg';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import EmailCopy from '../components/EmailCopy.astro';
import IconLink from '../components/IconLink.astro';
import seal from '@phosphor-icons/core/assets/regular/seal-check.svg?raw';
import arrowOut from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import { site, SHOW_PLACEHOLDERS, showDraft } from '../site';

const work = (await getCollection('work'))
  .filter((w) => SHOW_PLACEHOLDERS || w.data.status !== 'planned')
  .sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((w) => w.data.featured);
const writing = (await getCollection('writing'))
  .filter((p) => showDraft(p.data.status))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const more = work.filter((w) => !w.data.featured);

// AI workflow. Every tool and example below is on her resume or in the case studies.
const aiWork = [
  {
    title: 'Automated Market Intelligence',
    body: 'I used Claude Code and Codex to build the pipeline behind IC News Daily. The newsletter collects semiconductor news, picks the day\'s stories and sends them every morning to 40 readers in Futurewei\'s IC lab.',
    tools: 'Claude Code, Codex, Python, Outlook automation',
    href: '/work/daily-news-push/',
  },
  {
    title: 'AI Search and GEO',
    body: 'Co-first author of L-MARS, which checks whether cited sources support an AI system\'s answers, a problem closely related to generative engine optimization (GEO). I also worked on SEO at CambioML.',
    tools: 'GEO / AEO, SEO, ChatGPT, Claude, RAG',
    href: '/work/l-mars/',
  },
  {
    title: 'Content and Video Production',
    body: 'Average short-form video views grew from about 1K to 7K per post. I also edited event video for CASPA.',
    tools: 'Premiere Pro, Final Cut Pro, CapCut, Photoshop, Canva',
    href: '/work/echobend-social/',
  },
  {
    title: 'Analytics and Reporting',
    body: 'At CambioML, I used SEO and content analytics to raise backlinks 12% and weekly site reach about 15%. At Futurewei, I turn 30+ industry items a week into market insight reports.',
    tools: 'GA4, Meta Ads Manager, SQL, Python (pandas), Excel, PowerPoint',
    href: '/work/cambioml-seo/',
  },
];

const experience = [
  { when: '2026', role: 'Technical Marketing Intern', org: 'Futurewei' },
  { when: '2026', role: 'Marketing and Proceedings Volunteer', org: 'CASPA' },
  { when: '2024', role: 'Social Media Intern', org: 'Echobend' },
  { when: '2024', role: 'Marketing Intern, B2B and Growth', org: 'CambioML' },
  { when: '2023', role: 'Digital Media Assistant', org: 'University of Illinois' },
  { when: '2022', role: 'UX Researcher', org: 'University of Illinois' },
  { when: '2022', role: 'Advertising Campaigner', org: 'Amazon & GO' },
  { when: '2022', role: 'Co-founder and President', org: 'Choom dance crew' },
  { when: '2021', role: 'Brand Representative', org: 'Abercrombie & Fitch' },
];

const education = [
  { when: '2026', role: 'M.S. Digital Social Media', org: 'USC' },
  { when: '2024', role: 'B.S. Advertising', org: 'University of Illinois Urbana-Champaign' },
];

const certs = [
  { name: 'Google Data Analytics', issuer: 'Google, Coursera', when: '2026', group: 'Analytics and AI', url: 'https://www.coursera.org/account/accomplishments/specialization/3BPH4R94PCVL' },
  { name: 'Google AI Essentials', issuer: 'Google, Coursera', when: '2026', group: 'Analytics and AI', url: 'https://www.coursera.org/account/accomplishments/specialization/51J86WZ63O1G' },
  { name: 'Google Analytics (GAIQ)', issuer: 'Google', when: '2025', group: 'Analytics and AI', url: 'https://skillshop.credential.net/999b3c90-1d12-484b-8c0b-2e656d71c151#acc.NxMrTO6C' },
  { name: 'Google Ads Search', issuer: 'Google', when: '2023', group: 'Advertising and social', id: '195888093' },
  { name: 'Google Ads Display', issuer: 'Google', when: '2023', group: 'Advertising and social', id: '196427467' },
  { name: 'Amazon Sponsored Ads', issuer: 'Amazon Ads', when: '2022', group: 'Advertising and social', url: 'https://learningconsole.amazonadvertising.com/student/award/LeyCPjyFyDqyJmVoWernTgxY' },
  { name: 'Social Media Monitoring', issuer: 'LinkedIn Learning', when: '2023', group: 'Advertising and social', url: 'https://www.linkedin.com/learning/certificates/41c38e4a1d0e02eaa22ba31bf0d521481b02b3c78d5f7c2ce2cbaeafa962c09e' },
];
const certGroups = ['Advertising and social', 'Analytics and AI'].map((g) => ({ name: g, items: certs.filter((c) => c.group === g) }));


---

<Base>
  <section class="wrap hero">
    <div class="intro">
      <div class="me">
        <Image class="avatar" src={headshot} alt="Ziqi Wang" width={144} height={144} loading="eager" />
        <div>
          <h1>{site.name}</h1>
          <p class="muted">AI-native marketer, Technical Marketing Intern @ Futurewei</p>
        </div>
      </div>
      <p class="statement">I turn complex AI and semiconductor products into stories, campaigns and tools people use.</p>
      <p class="muted about">
        I'm Ziqi (Zoe) Wang, a technical marketer in San Jose, in marketing since 2022. My work spans retail media for a consumer brand,
        SEO and B2B growth at an AI startup, paid social and short-form video for client brands, and now
        technical marketing for a semiconductor ecosystem team. I follow new AI tools closely and build
        with Claude Code and Codex.
      </p>
      <div class="actions">
        <EmailCopy email={site.email} />
        <IconLink icon="resume" href={site.resume} text="Resume" label="Resume (PDF)" external />
        <IconLink icon="linkedin" href={site.linkedin} text="LinkedIn" external />
        <IconLink icon="scholar" href={site.scholar} text="Scholar" label="Google Scholar" external />
      </div>
    </div>
  </section>


  <section class="wrap ai" aria-labelledby="ai-title">
    <h2 id="ai-title" class="ai-title">How I Use AI in My Work</h2>
    <ul class="ai-grid">
      {
        aiWork.map((a) => (
          <li>
            <a href={a.href} class="ai-item">
              <h3>{a.title}</h3>
              <p class="muted">{a.body}</p>
              <p class="tools">{a.tools}</p>
              <span class="ai-link">See project →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    writing.length > 0 && (
      <section class="wrap writing" id="writing" aria-labelledby="writing-title">
        <h2 id="writing-title" class="label">Writing</h2>
        <ul class="posts">
          {writing.slice(0, 3).map((p) => (
            <li>
              <a href={`/writing/${p.id}/`} class="post">
                <span class="post-title">{p.data.title}</span>
                <span class="post-summary muted">{p.data.summary}</span>
                <span class="post-date">{fmtDate(p.data.date)}</span>
              </a>
            </li>
          ))}
        </ul>
        {writing.length > 3 && (
          <a href="/writing/" class="all-writing">All writing ({writing.length}) →</a>
        )}
      </section>
    )
  }

  <section class="wrap certs-strip" aria-labelledby="certs-title">
    <h2 id="certs-title" class="label">Certifications</h2>
    <div class="cert-groups">
      {
        certGroups.map((g) => (
          <div>
            <h3 class="cert-group">{g.name}</h3>
            <ul class="certs">
              {g.items.map((c) => {
                const inner = (
                  <>
                    <span class="seal" set:html={seal} />
                    <span class="cert-name">{c.name}</span>
                    <span class="cert-meta">{c.issuer}, {c.when}</span>
                    {c.url ? <span class="out" set:html={arrowOut} /> : <span class="out" aria-hidden="true" />}
                  </>
                );
                return (
                  <li>
                    {c.url ? (
                      <a class="cert" href={c.url} target="_blank" rel="noopener" title={`View the ${c.name} credential`}>{inner}</a>
                    ) : (
                      <span class="cert" title={c.id ? `Credential ID ${c.id}` : undefined}>{inner}</span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap" id="work">
    <h2 class="label">Selected Work</h2>
    <div class="grid">
      {featured.map((w, i) => <WorkCard entry={w} eager={i === 0} />)}
    </div>

    {
      more.length > 0 && (
        <div class="more">
          <h2 class="label">More Work</h2>
          <ul class="rows">
            {more.map((w) => (
              <li>
                <a href={`/work/${w.id}/`} class="row">
                  <span>{w.data.title}</span>
                  <span class="muted">{w.data.org}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="wrap cv" id="experience">
    <div>
      <h2 class="label">Experience</h2>
      <ul class="rows">
        {
          experience.map((e) => (
            <li class="row">
              <span class="when">{e.when}</span>
              <span>
                {e.role} <span class="muted">at {e.org}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="label">Education</h2>
      <ul class="rows">
        {
          education.map((e) => (
            <li class="row">
              <span class="when">{e.when}</span>
              <span>
                {e.role} <span class="muted">at {e.org}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>


<style>
  section + section {
    margin-top: 96px;
  }
  .hero {
    padding-top: 72px;
  }
  .hero > * {
    max-width: 960px;
  }
  .me {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .me :global(.avatar) {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .me h1 {
    font-size: 22px;
    letter-spacing: -0.015em;
  }
  .me p {
    font-size: 17px;
    margin-top: 2px;
  }
  .statement {
    margin-top: 36px;
    font-size: clamp(34px, 3.8vw, 54px);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.03em;
    max-width: 960px;
  }
  .about {
    margin-top: 20px;
    font-size: 16px;
    max-width: 60ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }


  .where {
    color: var(--faint);
    font-size: 13px !important;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px 32px;
  }
  .grid :global(.wide) {
    grid-column: 1 / -1;
  }
  .more {
    margin-top: 72px;
    max-width: 640px;
  }
  .writing {
    margin-top: 80px;
  }
  .posts {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    max-width: 1100px;
    border-top: 1px solid var(--line);
  }
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .post-title {
    font-weight: 500;
  }
  .post:hover .post-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-summary {
    grid-column: 1 / -1;
    font-size: 14px;
  }
  .post-date {
    grid-column: 2;
    grid-row: 1;
    font-size: 14px;
    color: var(--faint);
  }
  .all-writing {
    display: inline-block;
    margin-top: 14px;
    font-size: 14px;
    color: var(--accent);
  }
  .all-writing:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .certs-strip {
    margin-top: 64px;
  }
  @media (max-width: 640px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-date {
      grid-column: 1;
      grid-row: auto;
    }
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .row {
    display: flex;
    gap: 16px;
    padding: 7px 0;
  }
  .more .row {
    justify-content: space-between;
  }
  .more .row:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .when {
    width: 48px;
    flex-shrink: 0;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .cv {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  .ai {
    margin-top: 72px;
  }
  .ai-title {
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 500;
    letter-spacing: -0.025em;
    max-width: 26ch;
  }
  .ai-grid {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  .ai-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding-top: 18px;
    border-top: 2px solid var(--fg);
  }
  .ai-item h3 {
    font-size: 16px;
  }
  .ai-item:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ai-item p {
    font-size: 14px;
    line-height: 1.55;
  }
  .tools {
    margin-top: auto;
    padding-top: 8px;
    font-size: 13px !important;
    color: var(--faint);
  }
  .ai-link {
    font-size: 13px;
    color: var(--accent);
    margin-top: 4px;
  }
  .cert-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 48px;
    max-width: 1100px;
    margin-top: 16px;
  }
  .cert-group {
    font-size: 12px;
    font-weight: 400;
    color: var(--faint);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .certs {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cert {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    column-gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    position: relative;
    isolation: isolate;
  }
  /* Hover tint drawn behind the row, a little wider than the text, so the dividers stay aligned. */
  a.cert::before {
    content: '';
    position: absolute;
    inset: 3px -8px;
    z-index: -1;
    border-radius: 6px;
    background: #eef1fc;
    opacity: 0;
    transition: opacity 0.15s;
  }
  a.cert:hover::before {
    opacity: 1;
  }
  a.cert:focus-visible {
    outline: none;
  }
  a.cert:focus-visible::before {
    opacity: 1;
    box-shadow: inset 0 0 0 2px #b9c5f4;
  }
  .seal {
    display: grid;
    color: var(--accent);
  }
  .seal :global(svg) {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .cert-name {
    font-weight: 500;
  }
  .cert-meta {
    font-size: 13px;
    color: var(--faint);
    white-space: nowrap;
  }
  .out {
    display: grid;
    color: #667085;
    transition: color 0.15s, transform 0.15s;
  }
  .out :global(svg) {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  a.cert:hover .cert-name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a.cert:hover .out {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  .out:empty {
    width: 14px;
  }
  @media (max-width: 767px) {
    .cert-groups {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
    }
  }
  @media (max-width: 420px) {
    .cert {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: start;
      padding-top: 14px;
      padding-bottom: 14px;
    }
    .seal,
    .out {
      margin-top: 2px;
    }
    .cert-meta {
      grid-column: 2;
      grid-row: 2;
    }
  }

  @media (max-width: 1100px) {
    .ai-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    }
  @media (max-width: 767px) {
    section + section {
      margin-top: 56px;
    }
    .hero {
      padding-top: 40px;
    }
    .ai-grid,
    .grid,
    .cv {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .more .row {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
