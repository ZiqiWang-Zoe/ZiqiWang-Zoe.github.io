---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site, SHOW_PLACEHOLDERS } from '../site';

const work = (await getCollection('work'))
  .filter((w) => SHOW_PLACEHOLDERS || w.data.status !== 'planned')
  .sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((w) => w.data.featured);
const more = work.filter((w) => !w.data.featured);

const experience = [
  { when: '2026', role: 'Technical Marketing Intern', org: 'Futurewei' },
  { when: '2026', role: 'Marketing Volunteer', org: 'CASPA' },
  { when: '2024', role: 'Social Media Intern', org: 'Echobend' },
  { when: '2024', role: 'Marketing Intern, B2B and Growth', org: 'CambioML' },
  { when: '2023', role: 'Digital Media Assistant', org: 'University of Illinois' },
  { when: '2022', role: 'UX Researcher', org: 'University of Illinois' },
  { when: '2022', role: 'Advertising Campaigner', org: 'Amazon & GO' },
  { when: '2022', role: 'Co-founder and President', org: 'Choom dance crew' },
  { when: '2021', role: 'Brand Representative', org: 'Abercrombie & Fitch' },
];

const education = [
  { when: '2026', role: 'M.S. Digital Social Media', org: 'USC' },
  { when: '2024', role: 'B.S. Advertising', org: 'University of Illinois' },
];
---

<Base>
  <div class="col page">
    <header class="me">
      <!-- TODO(Ziqi): replace with a real headshot (square, 400x400 or larger) -->
      <div class="avatar" aria-hidden="true">ZW</div>
      <div>
        <h1>{site.name}</h1>
        <p class="muted">Technical Marketing @ Futurewei</p>
      </div>
    </header>

    <section>
      <p class="statement">I market technical products, and I build the tools I use to do it.</p>
      <p class="muted about">
        USC Digital Social Media graduate based in San Jose. I write for engineering audiences, run paid and
        short-form social, and co-authored <a class="link" href="/work/l-mars/">L-MARS</a>, a paper on how AI
        systems choose which sources to cite.
      </p>
      <div class="actions">
        <a class="pill pill-dark" href={`mailto:${site.email}`}>Email</a>
        <a class="pill" href={site.resume} target="_blank" rel="noopener">Resume</a>
        <a class="pill" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </section>

    <section id="work">
      <h2 class="label">Work</h2>
      <div class="cards">
        {featured.map((w, i) => <WorkCard entry={w} eager={i === 0} />)}
      </div>

      {
        more.length > 0 && (
          <ul class="rows more">
            {more.map((w) => (
              <li>
                <a href={`/work/${w.id}/`} class="row">
                  <span>{w.data.title}</span>
                  <span class="muted">{w.data.org}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section id="experience">
      <h2 class="label">Experience</h2>
      <ul class="rows">
        {
          experience.map((e) => (
            <li class="row">
              <span class="when">{e.when}</span>
              <span>
                {e.role} <span class="muted">at {e.org}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="label">Education</h2>
      <ul class="rows">
        {
          education.map((e) => (
            <li class="row">
              <span class="when">{e.when}</span>
              <span>
                {e.role} <span class="muted">at {e.org}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="muted certs">
        Certified in Google Ads Search and Display, Google Analytics, and Amazon Sponsored Ads.
      </p>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: 80px;
  }
  section {
    margin-top: 64px;
  }
  .me {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .me h1 {
    font-size: 15px;
  }
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--faint);
    display: grid;
    place-items: center;
    font-size: 14px;
    font-weight: 500;
    flex-shrink: 0;
  }
  .me + section {
    margin-top: 40px;
  }
  .statement {
    font-size: clamp(24px, 4.4vw, 30px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.025em;
    max-width: 22ch;
  }
  .about {
    margin-top: 16px;
    max-width: 58ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .cards {
    display: grid;
    gap: 48px;
  }
  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .row {
    display: flex;
    gap: 16px;
    padding: 7px 0;
  }
  .more {
    margin-top: 48px;
  }
  .more .row {
    justify-content: space-between;
  }
  .more .row:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .when {
    width: 48px;
    flex-shrink: 0;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .certs {
    margin-top: 16px;
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .page {
      padding-top: 48px;
    }
    .more .row {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
