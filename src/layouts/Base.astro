---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Technical Marketing`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  jobTitle: 'Technical Marketing',
  worksFor: { '@type': 'Organization', name: 'Futurewei Technologies' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Southern California' },
    { '@type': 'CollegeOrUniversity', name: 'University of Illinois Urbana-Champaign' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'San Jose', addressRegion: 'CA' },
  knowsAbout: [
    'Technical marketing',
    'Product marketing',
    'Answer engine optimization',
    'Paid social',
    'Short-form video',
    'SEO',
    'Claude Code',
  ],
  sameAs: [site.linkedin, site.github, site.arxiv],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="author" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- TODO: og:image (1200x630) once a real photo of Ziqi exists -->
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
