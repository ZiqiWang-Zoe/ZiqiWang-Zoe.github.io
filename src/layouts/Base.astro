---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { site } from '../site';
import headshot from '../assets/ziqi.jpg';

interface Props {
  title?: string;
  description?: string;
  narrow?: boolean;
}

const { title, description = site.description, narrow = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Technical Marketing`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL((await getImage({ src: headshot, width: 600, height: 600, format: 'jpg' })).src, Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href,
  image: ogImage,
  email: `mailto:${site.email}`,
  jobTitle: 'Technical Marketing',
  worksFor: { '@type': 'Organization', name: 'Futurewei Technologies' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Southern California' },
    { '@type': 'CollegeOrUniversity', name: 'University of Illinois Urbana-Champaign' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'San Jose', addressRegion: 'CA' },
  knowsAbout: [
    'Technical marketing',
    'Product marketing',
    'Answer engine optimization',
    'Paid social',
    'Short-form video',
    'SEO',
    'Claude Code',
  ],
  sameAs: [site.linkedin, site.github, site.arxiv, site.scholar].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="author" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Ziqi Wang" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <Footer narrow={narrow} />
  </body>
</html>
